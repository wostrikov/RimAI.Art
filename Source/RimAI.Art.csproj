<Project Sdk="Microsoft.NET.Sdk">
  <!--
    RimWorld 1.7 and nothing older. 1.7 is not a Unity player: it runs on
    .NET 10, its assemblies sit in the game folder itself, and one assembly -
    UnityStubs - stands in for everything that was UnityEngine.*Module.dll.
    So this is net10.0 and compiles against that stand-in, which turns a
    Unity member 1.7 does not have into a compile error here instead of a
    type that fails to load there. The 1.6 build is the tag
    rimworld-1.6-final.
  -->

  <!--
    RimTalk Literature Expansion (Add-on Mod)
    Build:
      dotnet build -p:GameVersion=1.6
    Output:
      <ProjectDir>\<GameVersion>\Assemblies\Ustas.RimAI.Art.dll
  -->

  <PropertyGroup>
    <!-- Defaults -->
    <GameVersion Condition=" '$(GameVersion)' == '' ">1.7</GameVersion>

    <TargetFramework>net10.0</TargetFramework>
    <!-- The game loads a mod assembly from the mod's own folder: no deps
         file beside it. A package this mod ships has to reach the output. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <RootNamespace>Ustas.RimAI.Art</RootNamespace>
    <AssemblyName>RimAI.Art</AssemblyName>

    <!-- RimWorld mod layout: put DLL directly under <GameVersion>/Assemblies -->
    <BaseOutputPath Condition=" '$(BaseOutputPath)' == '' ">$(LOCALAPPDATA)\Ustas\RimWorldSourceBuilds\RimAI.Art\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath Condition=" '$(BaseIntermediateOutputPath)' == '' ">$(LOCALAPPDATA)\Ustas\RimWorldSourceBuilds\RimAI.Art\obj\</BaseIntermediateOutputPath>
    <OutputPath>$(BaseOutputPath)$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- VSCode/OmniSharp: do not fall back to C# 7.3 -->
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Mod assemblies: keep outputs clean -->
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>

    <!-- Make it easier to evolve this add-on without blocking builds -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Optional version defines for conditional compilation -->
  <PropertyGroup Condition=" '$(GameVersion)' == '1.5' ">
    <DefineConstants>$(DefineConstants);V1_5</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(GameVersion)' == '1.6' ">
    <DefineConstants>$(DefineConstants);V1_6</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference pack for RimWorld types (Verse/RimWorld/Unity) -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="$(GameVersion).*-*" PrivateAssets="All" />
    <!-- Harmony reference -->
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.2" ExcludeAssets="runtime" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\RimAI.Core\src\RimAI.Core\RimAI.Core.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\RimAI.Communication\Source\RimAI.Communication.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- Prompt templates: embed into the assembly to avoid file path issues -->
  <ItemGroup>
    <EmbeddedResource Include="promptoverride\templates\**\*.txt" />
  </ItemGroup>

</Project>

